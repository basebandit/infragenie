  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "USD spent (total)",
      "datasource": {"type": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "sum(infragenie_llm_usd_total)", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto", "colorMode": "value"},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}}
    },
    {
      "type": "stat",
      "title": "Tokens (total)",
      "datasource": {"type": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "sum(infragenie_llm_tokens_total)", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "stat",
      "title": "Cache hit rate",
      "datasource": {"type": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "sum(rate(infragenie_llm_calls_total{cache_hit=\"true\"}[5m])) / sum(rate(infragenie_llm_calls_total[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    },
    {
      "type": "stat",
      "title": "Calls / min",
      "datasource": {"type": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "sum(rate(infragenie_llm_calls_total[1m])) * 60", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "USD spend rate by model",
      "datasource": {"type": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "targets": [{"expr": "sum(rate(infragenie_llm_usd_total[5m])) by (model)", "legendFormat": "{{model}}", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Tokens by kind",
      "datasource": {"type": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "targets": [{"expr": "sum(rate(infragenie_llm_tokens_total[5m])) by (kind)", "legendFormat": "{{kind}}", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "p95 call latency by model",
      "datasource": {"type": "prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 13},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(infragenie_llm_call_seconds_bucket[5m])) by (le, model))", "legendFormat": "{{model}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    }
  ],
