# Environment variables for infragenie.
# Copy to .env.local and source it, or use direnv with a .envrc file.
# All values here override ~/.config/infragenie/config.yml.
# CLI flags override everything.

# ── LLM provider API keys ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_API_KEY=

# ── LLM model overrides (leave blank to use config file or provider default) ──
ANTHROPIC_MODEL=
OPENAI_MODEL=
GOOGLE_MODEL=
AZURE_OPENAI_MODEL=
LOCAL_LLM_MODEL=

# ── Provider endpoints ────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=
LOCAL_LLM_URL=http://localhost:11434   # Ollama or any OpenAI-compatible server

# ── infragenie run defaults ───────────────────────────────────────────────────
# These are overridden by CLI flags but save you typing them every run.
INFRAGENIE_PROVIDER=          # e.g. openai | anthropic | local
INFRAGENIE_FORMAT=            # text | json | github
INFRAGENIE_FAIL_ON=           # critical | high | medium | low
INFRAGENIE_BUDGET_TOKENS=     # max tokens per run (0 = unlimited)
INFRAGENIE_BUDGET_USD=        # max USD per run  (0 = unlimited)

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=                 # required for --pr reviews

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=  # enable OTLP trace export
