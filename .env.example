# Environment variables for infragenie.
# Usage:
#   cp .env.example .env.local
#   # fill in values
#   source .env.local          # or: set -a; source .env.local; set +a
#
# All values here override ~/.config/infragenie/config.yml.
# CLI flags override everything.
#
# IMPORTANT: variables must be exported to reach child processes.
# Either use `export VAR=value` or source with `set -a`.

# ── LLM provider API keys ─────────────────────────────────────────────────────
export ANTHROPIC_API_KEY=
export OPENAI_API_KEY=
export GOOGLE_API_KEY=
export AZURE_OPENAI_API_KEY=

# ── LLM model overrides (leave blank to use config file or provider default) ──
export ANTHROPIC_MODEL=
export OPENAI_MODEL=
export GOOGLE_MODEL=
export AZURE_OPENAI_MODEL=
export LOCAL_LLM_MODEL=

# ── Provider endpoints ────────────────────────────────────────────────────────
export AZURE_OPENAI_ENDPOINT=
export LOCAL_LLM_URL=http://localhost:11434

# ── infragenie run defaults ───────────────────────────────────────────────────
export INFRAGENIE_PROVIDER=       # openai | anthropic | local | google | azure
export INFRAGENIE_FORMAT=         # text | json | github
export INFRAGENIE_FAIL_ON=        # critical | high | medium | low
export INFRAGENIE_BUDGET_TOKENS=  # max tokens per run (0 = unlimited)
export INFRAGENIE_BUDGET_USD=     # max USD per run  (0 = unlimited)

# ── GitHub ────────────────────────────────────────────────────────────────────
export GITHUB_TOKEN=

# ── Observability ─────────────────────────────────────────────────────────────
export OTEL_EXPORTER_OTLP_ENDPOINT=
