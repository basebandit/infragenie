# Environment variables for infragenie
# Copy to .env.local and fill in your keys.
# These override values in ~/.config/infragenie/config.yml.

# ── LLM providers ─────────────────────────────────────────────────────────────
# Set the key for whichever provider you use with --provider.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Azure OpenAI (endpoint also settable in config.yml)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Self-hosted / Ollama — overrides local.base_url in config.yml
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=

# ── GitHub ────────────────────────────────────────────────────────────────────
# Required for --pr reviews.
GITHUB_TOKEN=

# ── Observability (optional) ──────────────────────────────────────────────────
# Set to enable OTLP trace export.
OTEL_EXPORTER_OTLP_ENDPOINT=
